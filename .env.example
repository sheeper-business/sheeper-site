# Resend (https://resend.com) — required for the contact form
RESEND_API_KEY=
# Must use a sender address on a domain verified in Resend, e.g. Sheeper <notifications@sheeper.app>
RESEND_FROM=

# Where contact form emails are delivered (default if unset: sheeper.business@gmail.com)
CONTACT_TO_EMAIL=sheeper.business@gmail.com
