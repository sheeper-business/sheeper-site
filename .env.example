# Resend (https://resend.com) — required for the contact form
RESEND_API_KEY=re_xxxxxxxx

# Sender must be on a domain you verified in Resend (Domains → add DNS records).
# Example: onboarding@resend.dev only works for testing to your own email in some accounts.
RESEND_FROM=Sheeper <notifications@yourdomain.com>

# Inbox for contact form submissions
CONTACT_TO_EMAIL=sheeper.business@gmail.com

# If the form returns 502, open the browser Network tab → /api/contact response JSON "reason"
# Common fixes: wrong API key; RESEND_FROM not on a verified domain; Resend account limits.
